# Copy to .env and fill in. .env is gitignored - never commit it.
TELEGRAM_TOKEN=
GROQ_API_KEY=
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Telegram group where warnings and approval buttons are posted (negative id)
ADMIN_CHAT_ID=

# Model availability differs per Groq account. List yours with Groq().models.list()
# and verify with: python check.py --live
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Render sets PORT automatically. WEBHOOK_URL = your Render service URL.
PORT=8080
WEBHOOK_URL=
# Leave WEBHOOK_URL empty to run long-polling (local dev).
