# Copy to .env and fill in. .env is gitignored - never commit it.
TELEGRAM_TOKEN=
GROQ_API_KEY=
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Telegram group where warnings and approval buttons are posted (negative id)
ADMIN_CHAT_ID=

# Model availability differs per Groq account. List yours with Groq().models.list()
# and verify with: python check.py --live
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Render sets PORT automatically.
PORT=8080

# LEAVE THIS EMPTY. It is the switch between webhook and long-polling, not a
# setting you look up: on Render the app falls back to RENDER_EXTERNAL_URL,
# and empty means long-polling, which is what you want locally. Filling it in
# on your own machine would register a webhook from your laptop and steal
# message delivery from the deployed bot. Only set it for a custom domain.
WEBHOOK_URL=
